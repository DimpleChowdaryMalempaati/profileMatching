# Optional: use OpenAI embeddings instead of local HuggingFace model
# OPENAI_API_KEY=sk-...

# Embedding provider: "chroma" (default, ONNX/local), "sentence-transformers", or "openai"
EMBEDDING_PROVIDER=chroma

# Model name (used when EMBEDDING_PROVIDER=sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=data/chroma_db

# Resume and job description directories
RESUMES_DIR=resumes
JOB_DESCRIPTIONS_DIR=job_descriptions
